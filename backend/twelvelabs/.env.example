# Copy this file to .env (in this directory: backend/twelvelabs/.env) and
# fill in real values. Never commit the .env file.

# Required. TwelveLabs API key — used for all video upload/indexing/analysis
# endpoints. Get one at https://playground.twelvelabs.io/dashboard/api-key.
# The backend refuses to start if this is unset.
TWELVELABS_API_KEY=

# Required for upload/review/search/summary endpoints (health check works
# without it). Create the index once via `python scripts/setup_index.py`
# from the repo root — that script prints/writes the ID for you.
TWELVELABS_INDEX_ID=

# Optional. Only needed for the /api/tts endpoint (text-to-speech). Get one
# at https://elevenlabs.io/app/settings/api-keys. The endpoint returns a
# clean 500 error (no crash) if this is unset.
ELEVENLABS_API_KEY=

# Optional. Comma-separated list of allowed frontend origins for CORS.
# Defaults to http://localhost:8080 (the Vite dev server) if unset.
# In docker-compose, override with the frontend service's origin, e.g.
# http://localhost:8080 (host-mapped) or http://frontend:8080 (container-to-container).
CORS_ORIGINS=http://localhost:8080
